# --- Deployment (taskpay/DEPLOY.md) ---
# Deployer = contract owner. Fund the deployer from the testnet faucet.
PRIVATE_KEY=0x...

# Oracle wallet (the account set as `oracle` on TaskPay.sol) — the oracle
# service signs with this. In production use a separate low-balance wallet
# from the deployer; for a single-wallet testnet run it may equal the deployer.
ORACLE_ADDRESS=0x...

# --- Network ---
# Testnet: https://rpc.bohr.life  (chain 968)
# Mainnet: https://rpc.botchain.ai (chain 677)
RPC_URL=https://rpc.bohr.life
# Mainnet disables eth_getLogs on the HTTP RPC; set the WebSocket endpoint so
# the oracle receives events live via eth_subscribe. Leave unset on testnet.
WSS_RPC_URL=
CHAIN_ID=968

# --- TaskPay contract (filled after deploy) ---
CONTRACT_ADDRESS=0x...

# --- Oracle AI provider (taskpay/oracle — Groq, OpenAI-compatible) ---
GROQ_API_KEY=gsk_...
# Optional: override the Groq model (default openai/gpt-oss-120b).
GROQ_MODEL=

# --- Oracle polling cadence (seconds) ---
POLL_INTERVAL_SECONDS=10

# --- Oracle optional overrides ---
# Pin the block to replay events from. When unset the oracle resumes its
# persisted poller cursor (data/poller-cursor.json) or backfills from head
# minus ~4h on a truly fresh data dir. Set only to force a specific replay.
ORACLE_START_BLOCK=
# Max sponsored ops per address per minute for /v1/quote + /v1/send (0 disables).
ORACLE_BUNDLER_RATE_LIMIT=20
# Raise the unauthenticated GitHub 60 req/hr limit (recommended for demos).
GITHUB_TOKEN=
# Publish bot deliverables as GitHub evidence: "owner/repo" (or a repo URL).
# When set (with GITHUB_TOKEN that can write to the repo) bots commit the
# deliverable files there and submit a pinned `repo@<sha>` pointer, so the
# dispute agents fetch the FULL artifact instead of judging truncated on-chain
# text. Unset = inline text (capped at 2,000 chars on-chain). The repo is
# created on first use if it does not exist.
GITHUB_EVIDENCE_REPO=
# Branch namespace for evidence (default "taskpay"): files land on
# "<prefix>/task-<taskId>/<botName>" so each task+bot pair gets its own ref.
GITHUB_EVIDENCE_BRANCH_PREFIX=
# Max total bytes of repo content sent to the AI (default 1_000_000).
ORACLE_MAX_REPO_BYTES=
# Where human-readable reasoning/spec text is archived (default taskpay/data).
TASKPAY_DATA_DIR=

# --- ERC-4337 sponsor stack (taskpay/oracle bundler, Phase 4) ---
# Canonical v0.7 EntryPoint (byte-identical to mainnet; live on testnet).
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# SimpleAccountFactory + VerifyingPaymaster (deployed via script/DeployAA.s.sol).
# The paymaster's verifyingSigner is ORACLE_ADDRESS; fund its EntryPoint deposit
# with `cast send <PAYMASTER> "deposit()" --value <amt>`.
AA_FACTORY=0x...
PAYMASTER=0x...
# Port the oracle serves /v1/quote + /v1/send on (frontend NEXT_PUBLIC_BUNDLER_URL).
PORT=8787

# --- Autonomous agent bot(s) (oracle/src/bot) ---
# Set to run one or more self-operating TaskPay workers inside the oracle: each
# accepts tasks created to its smart account (or races the others to claim open
# first-come-first-served tasks) and submits a Groq-generated deliverable, all
# gasless. Legacy single-bot config (leave AGENT_BOTS unset for this):
AGENT_BOT_PRIVATE_KEY=0x...
# Optional: a scoped session key (0x-prefixed 32-byte hex) the bot signs with
# instead of the master key. The bot self-authorizes it at startup (acceptTask +
# submitWork on TaskPay only, value-free, 7-day expiry) when its account supports
# session keys; otherwise it falls back to master-key signing.
AGENT_BOT_SESSION_KEY=
# Optional: display name (default DevBot), poll cadence in seconds (default 12),
# model override (default same as GROQ_MODEL), and whether to accept tasks
# outside its keyword profile (default false — the bot declines non-matching
# specs so it only takes work it can actually deliver).
#
# Multi-agent roster — REPLACES the single-bot config when present: a JSON array,
# one entry per competing identity. Each needs a "key"; optional fields inherit
# the AGENT_BOT_* vars above (name/pollSeconds/model/acceptAll) plus "profile"
# (keyword list specializing which specs that agent accepts) and "sessionKey"
# (per-agent scoped signer, replacing the shared AGENT_BOT_SESSION_KEY).
# AGENT_BOTS=[{"key":"0x...","name":"DevBot","acceptAll":true},{"key":"0x...","name":"Aria","sessionKey":"0x..."}]
AGENT_BOT_NAME=
AGENT_BOT_POLL_SECONDS=
AGENT_BOT_MODEL=
AGENT_BOT_ACCEPT_ALL=false
