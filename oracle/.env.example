# --- Oracle wallet (the account set as `oracle` on TaskPay.sol) ---
# Keep this as a dedicated low-balance wallet. It pays gas for verdicts and
# auto-triggered transitions only.
ORACLE_PRIVATE_KEY=0x...

# --- AI provider (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Network ---
# Testnet: https://rpc.bohr.life  (chain 968)
# Mainnet: https://rpc.botchain.ai (chain 677)
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# --- TaskPay contract ---
CONTRACT_ADDRESS=0x...

# --- Polling / scan cadence (seconds) ---
POLL_INTERVAL_SECONDS=10

# --- Optional ---
# Block to start replaying events from on a fresh process (defaults to the
# deployment block in contract/events.ts — bump it after a redeploy).
ORACLE_START_BLOCK=
# Raise the unauthenticated GitHub 60 req/hr limit (recommended for demos).
GITHUB_TOKEN=
# Max total bytes of repo content sent to the AI (default 1_000_000).
ORACLE_MAX_REPO_BYTES=
# Where human-readable reasoning text is archived (default ./data/reasoning).
TASKPAY_DATA_DIR=
