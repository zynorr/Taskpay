# --- Oracle wallet (the account set as `oracle` on TaskPay.sol) ---
# Keep this as a dedicated low-balance wallet. It pays gas for verdicts and
# auto-triggered transitions only.
ORACLE_PRIVATE_KEY=0x...

# --- AI provider (Groq, OpenAI-compatible) ---
GROQ_API_KEY=gsk_...
# Optional: override the Groq model (default openai/gpt-oss-120b).
GROQ_MODEL=

# --- Network ---
# Testnet: https://rpc.bohr.life  (chain 968)
# Mainnet: https://rpc.botchain.ai (chain 677)
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# --- TaskPay contract ---
CONTRACT_ADDRESS=0x...

# --- Polling / scan cadence (seconds) ---
POLL_INTERVAL_SECONDS=10

# --- Optional ---
# Pin the block to replay events from. Boot order when unset: the persisted
# poller cursor (data/poller-cursor.json) is resumed, or — with no cursor —
# the poller backfills from head minus ~4h. Only set this to force a replay
# from a specific point (e.g. after a redeploy).
ORACLE_START_BLOCK=
# Max sponsored ops per address per minute for /v1/quote + /v1/send (0 disables).
ORACLE_BUNDLER_RATE_LIMIT=20
# Raise the unauthenticated GitHub 60 req/hr limit (recommended for demos).
GITHUB_TOKEN=
# Max total bytes of repo content sent to the AI (default 1_000_000).
ORACLE_MAX_REPO_BYTES=
# Where human-readable reasoning text is archived (default ./data/reasoning).
TASKPAY_DATA_DIR=

# --- ERC-4337 sponsor stack (bundler + paymaster signer = oracle) ---
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
AA_FACTORY=0x...
PAYMASTER=0x...

# --- Autonomous agent bot(s) ---
# Legacy single-bot config: with AGENT_BOT_PRIVATE_KEY set, the oracle runs one
# agent persona that accepts tasks created to its smart account (or claims open
# first-come-first-served tasks) and submits a Groq-generated deliverable, all
# gasless (see oracle/src/bot).
AGENT_BOT_PRIVATE_KEY=0x...
AGENT_BOT_NAME=DevBot
AGENT_BOT_POLL_SECONDS=2
AGENT_BOT_MODEL=
AGENT_BOT_ACCEPT_ALL=false
#
# Multi-agent roster — REPLACES the single-bot config above when present. Each
# array entry spawns one competing agent identity (distinct on-chain key /
# persona). Open tasks go first-come-first-served: whichever agent claims first
# does the task. Fields omitted per entry inherit the shared AGENT_BOT_* vars
# (poll cadence, model, accept-all flag) and then code defaults.
#   key:        EOA private key owning the agent's SimpleAccount (required)
#   name:       display name used in logs + the persona prompt (default "Agent N")
#   model:      Groq model override (default GROQ_MODEL)
#   pollSeconds:task scan cadence override (default AGENT_BOT_POLL_SECONDS)
#   acceptAll:  true = take any open task; false/omit = keyword profile filter
#   profile:    optional keyword list to specialize this agent (default: broad
#               coding profile). An agent with a profile skips specs that don't
#               match any keyword, so several agents can divide the pool.
# AGENT_BOTS=[{"key":"0x...","name":"DevBot","acceptAll":true},{"key":"0x...","name":"Aria"},{"key":"0x...","name":"Koda","profile":["write","documentation"]}]
