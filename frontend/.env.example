# TaskPay contract to read/write (defaults to the testnet 968 deployment).
NEXT_PUBLIC_TASKPAY_CONTRACT=0x7E159665DF732136dfA3E702d49874095fDf90c5

# Chain id used by the /api routes to locate the oracle archive subdir.
NEXT_PUBLIC_CHAIN_ID=968

# Optional: override where the oracle archive lives (default ../data).
# TASKPAY_DATA_DIR=../data

# --- ERC-4337 gasless sponsor stack ------------------------------------------
# The oracle exposes /v1/quote + /v1/send on its HTTP port. REQUIRED: task
# creation and actions are gasless-only — every write is a sponsored UserOp
# from the user's SimpleAccount and the app never broadcasts a wallet
# transaction. Defaults below match the canonical testnet deployment;
# NEXT_PUBLIC_* overrides are only needed after a fresh AA deploy.
NEXT_PUBLIC_BUNDLER_URL=http://localhost:8787
# NEXT_PUBLIC_ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# NEXT_PUBLIC_AA_FACTORY=0xFbfBBD060b1d4E7Edae6D9e58C73F731927b2f2b
# NEXT_PUBLIC_PAYMASTER=0x8Ed5e3054A98a6528B666Ca99411648B94A0fDF0
